    "@lexical/link": "0.48.0",
    "@lexical/list": "0.48.0",
    "@lexical/rich-text": "0.48.0",
    "@mdxeditor/editor": "~4.3.2",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dompurify": "^3.4.16",
    "lexical": "0.48.0",
    "lucide-react": "^1.52.0",
