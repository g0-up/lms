    "test:watch": "vitest",
    "test:e2e": "playwright test -c e2e/playwright.config.ts --project=e2e --project=a11y",
    "test:a11y": "playwright test -c e2e/playwright.config.ts --project=a11y",
    "render-check": "playwright test -c e2e/playwright.config.ts --project=render"
  },
