# Copy thành apps/api/.env cho máy dev rồi điền phần còn trống. Không commit .env.
# Các lệnh `make dev`, `make dev-api`, `make migrate-up`... tự nạp file này.

# Môi trường chạy: dev | e2e | production
APP_ENV=dev
# Địa chỉ lắng nghe của API
HTTP_ADDR=:8080
# Gốc URL web người dùng mở (Vite dev); dùng tạo link trong email
PUBLIC_BASE_URL=http://localhost:5173
# Postgres của compose dev (mật khẩu lms chỉ dùng ở máy dev)
DATABASE_URL=postgres://lms:lms@localhost:5432/lms?sslmode=disable
# Integration test (go test -tags integration) dùng database lms_test do compose dev tạo sẵn
TEST_DATABASE_URL=postgres://lms:lms@localhost:5432/lms_test?sslmode=disable
# Tự chạy migration khi `lms serve` khởi động
MIGRATE_ON_START=false
# Mức log: debug | info | warn | error
LOG_LEVEL=debug
# Múi giờ nghiệp vụ
APP_TZ=Asia/Ho_Chi_Minh

# Cookie chỉ gửi qua https; dev chạy http nên để false
COOKIE_SECURE=false

# Mailpit của compose dev (UI http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="GoUp LMS <no-reply@localhost>"
# Bắt buộc, base64 của 32 byte ngẫu nhiên: openssl rand -base64 32
OUTBOX_SECRET_KEY=

# MinIO của compose dev (console http://localhost:9001, chỉ dùng ở máy dev)
S3_ENDPOINT=localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=lms-media
S3_ACCESS_KEY=lmsminio
S3_SECRET_KEY=lmsminio123
S3_USE_SSL=false

# Mật khẩu chung cho tài khoản mẫu của `lms seed` (dev tự đặt)
SEED_PASSWORD=
