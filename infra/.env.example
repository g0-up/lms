# Copy thành infra/.env trên VPS (hoặc máy homelab) rồi điền giá trị thật. Không commit infra/.env.
# Biến bỏ trống là secret: compose chỉ kiểm có mặt, API từ chối khởi động nếu để rỗng.

# --- Caddy / compose ---
# Hostname public của LMS (Caddy xin chứng chỉ cho tên này; homelab dùng làm Host của router Traefik)
DOMAIN=lms.example.vn
# Chỉ homelab: hostname riêng trỏ thẳng vào API (Caddy production không dùng)
API_DOMAIN=lms-api.example.vn
# Email đăng ký chứng chỉ Let's Encrypt (homelab không dùng nhưng vẫn phải có giá trị)
ACME_EMAIL=admin@example.vn
# Origin của S3_PUBLIC_ENDPOINT, đưa vào CSP media-src/connect-src (presigned PUT và <video src>)
MEDIA_ORIGIN=https://<account>.r2.cloudflarestorage.com

# --- Postgres (chỉ trong mạng compose, không publish cổng) ---
# Tên database
POSTGRES_DB=lms
# Tài khoản database
POSTGRES_USER=lms
# Mật khẩu database: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Ứng dụng ---
# Môi trường chạy: production bật mọi kiểm tra an toàn (https, cookie Secure, S3 SSL, SMTP_USER)
APP_ENV=production
# Gốc URL công khai, phải là https ở production
PUBLIC_BASE_URL=https://lms.example.vn
# Chạy migration khi api khởi động (worker luôn tắt)
MIGRATE_ON_START=true
# Mức log: debug | info | warn | error
LOG_LEVEL=info
# Múi giờ nghiệp vụ
APP_TZ=Asia/Ho_Chi_Minh

# --- Phiên đăng nhập và mật khẩu ---
# Thời gian sống của phiên đăng nhập
SESSION_TTL=12h
# Cờ Secure của cookie phiên; production bắt buộc true
COOKIE_SECURE=true
# CIDR proxy được tin X-Forwarded-For, phân tách dấu phẩy; rỗng = không tin (ví dụ mạng compose của Caddy: 172.16.0.0/12)
TRUSTED_PROXIES=
# Độ dài tối thiểu của mật khẩu mới (>= 8)
PASSWORD_MIN_LENGTH=8
# Hạn dùng mật khẩu tạm gửi qua email mời
TEMP_PASSWORD_TTL=72h
# Hạn dùng link đặt lại mật khẩu
RESET_TOKEN_TTL=30m
# Số lần đăng nhập sai liên tiếp trước khi khóa email
LOGIN_MAX_FAILURES=5
# Cửa sổ đếm và thời gian khóa đăng nhập theo email
LOGIN_LOCK_WINDOW=15m
# Giới hạn POST /auth/login mỗi IP mỗi phút
RATE_LIMIT_LOGIN_IP_PER_MIN=300
# Giới hạn POST /auth/forgot-password mỗi IP mỗi phút
RATE_LIMIT_FORGOT_IP_PER_MIN=30

# --- Email (SMTP, tự dùng STARTTLS khi server hỗ trợ) ---
# Máy chủ SMTP
SMTP_HOST=smtp.example.vn
# Cổng SMTP
SMTP_PORT=587
# Tài khoản SMTP (production bắt buộc)
SMTP_USER=
# Mật khẩu SMTP
SMTP_PASSWORD=
# Người gửi hiển thị trong email
MAIL_FROM="GoUp LMS <no-reply@lms.example.vn>"
# Chỉ e2e: email người nhận khớp mẫu này bị giả lập gửi lỗi; production để trống
MAIL_FAIL_PATTERN=
# Chu kỳ worker quét hàng đợi email
EMAIL_POLL_INTERVAL=5s
# Khóa AES-256-GCM mã hóa bí mật trong email outbox: openssl rand -base64 32
OUTBOX_SECRET_KEY=

# --- Object storage: Cloudflare R2 (S3-compatible) ---
# Endpoint S3 API mà api gọi (host, không có scheme)
S3_ENDPOINT=<account>.r2.cloudflarestorage.com
# URL trình duyệt thấy, dùng để ký presigned URL (cùng endpoint hoặc custom domain R2)
S3_PUBLIC_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# Region; R2 dùng auto
S3_REGION=auto
# Bucket chứa video và ảnh
S3_BUCKET=lms-media
# Access key R2 (API token có quyền Object Read & Write trên bucket)
S3_ACCESS_KEY=
# Secret key R2
S3_SECRET_KEY=
# Gọi S3 qua https; production bắt buộc true
S3_USE_SSL=true
# Hạn dùng URL ký để xem/tải media
MEDIA_URL_TTL=2h
# Dung lượng video tối đa (byte), mặc định 2 GiB
MAX_VIDEO_BYTES=2147483648
# Dung lượng ảnh tối đa (byte), mặc định 10 MiB
MAX_IMAGE_BYTES=10485760

# --- Báo cáo ---
# Số ngày không hoạt động để coi học viên là "lâu không hoạt động"
STALE_DAYS=7
